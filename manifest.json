{
    "manifest_version": 3,
    "name": "Diplodocus",
    "version": "1.0",
    "description": "Automatically replaces \"Claude Opus\" (and \"Opus\") with \"Diplodocus\" on every webpage.",
    "icons": {
        "16": "icons/diplodocus.png",
        "48": "icons/diplodocus.png",
        "128": "icons/diplodocus.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "diplodocus-replacer@alexisamadei",
            "strict_min_version": "109.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}